# Netrabindu - Environment Configuration
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+asyncpg://netrabindu:netrabindu_secret@localhost:5432/netrabindu
SYNC_DATABASE_URL=postgresql+psycopg2://netrabindu:netrabindu_secret@localhost:5432/netrabindu
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Hot Lookups
REDIS_URL=redis://localhost:6379/0

# Event Bus (Redpanda / Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=netrabindu-control-plane
KAFKA_GROUP_ID=netrabindu-core-group
KAFKA_USE_LOCAL_FALLBACK=true

# Object Storage (MinIO / S3)
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=evidence
OBJECT_STORE_USE_SSL=false

# Stream Gateway (MediaMTX)
MEDIAMTX_API_URL=http://localhost:8554
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_HLS_URL=http://localhost:8888

# Security & Authentication
JWT_ISSUER=netrabindu-core
JWT_SECRET=super-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
OIDC_ISSUER=
DEFAULT_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80
ALERT_WS_ORIGIN=http://localhost:3000,http://localhost:5173

# Initial Admin Setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePass123!
ADMIN_EMAIL=admin@police.gujarat.gov.in
ADMIN_DEPARTMENT=DEPT-HQ
